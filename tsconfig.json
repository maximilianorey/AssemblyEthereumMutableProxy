{
    "compilerOptions": {
      "lib": ["ES2024"],
      "moduleResolution": "NodeNext",
  
      "esModuleInterop": true,
      "forceConsistentCasingInFileNames": true,
      "isolatedModules": true,
      "module": "NodeNext",
      "outDir": "./dist",
      "rootDir": "./src",
      "skipLibCheck": true,
      "strict": true,
      "resolveJsonModule": true,
      "target": "ES2024",
      "noImplicitAny": false,
      "noErrorTruncation": true
    },
    "include": [
      "./src/**/*.ts",
      "./src/**/*.js"
    ],
    "$schema": "https://json.schemastore.org/tsconfig",
    "display": "Recommended"
}