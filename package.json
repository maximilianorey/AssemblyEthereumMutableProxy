{
  "name": "assemblyproxy",
  "version": "0.1.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "assembly": "sh assembly.sh",
    "build": "tsc -b",
    "compile": "rm -f -r ./out && rm -f -r ./src/out && forge compile contracts && mv ./out ./src/ && node ./generateContractsTypescriptFiles.cjs",
    "generate-mnemonic": "node ./dist/generateMnemonic.js",
    "test": "forge test",
    "test-gas-usage-testnet": "node ./dist/timeTests/testGasUsage.js",
    "test-gas-usage-local": "node ./dist/timeTests/testGasUsageLocal.js",
    "lint": "eslint . --fix"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.4.0",
    "@ethereumjs/wallet": "10.0.0",
    "bip39": "3.1.0",
    "viem": "2.56.3"
  },
  "devDependencies": {
    "@typechain/ethers-v6": "0.5.1",
    "@types/mocha": "10.0.10",
    "@types/node": "22.13.4",
    "@eslint/js": "9.32.0",
    "@stylistic/eslint-plugin": "5.10.0",
    "dotenv": "16.4.7",
    "eslint": "9.32.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-json": "4.0.1",
    "eslint-plugin-prettier": "5.2.3",
    "prettier": "3.5.1",
    "ts-node": "10.9.2",
    "typescript": "5.7.3",
    "typescript-eslint": "8.24.0"
  },
