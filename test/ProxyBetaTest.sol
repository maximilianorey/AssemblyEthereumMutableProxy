pragma solidity ^0.8.26;

import {Test} from "forge-std/Test.sol";
import "../contracts/AssemblyProxyBeta.sol";
import "./utils/AssemblyProxyBetaPayable.sol";
import "../contracts/ERC20Imp.sol";
import "../contracts/ERC20Imp_2.sol";

contract ProxyBetaTest is Test {
    function test_beta() public {
        bytes memory bytecode = hex"";
        uint256 codelength = bytecode.length;
        address targetContract;
        assembly {
             mstore(add(bytecode,add(32,1)),address())
            mstore(add(bytecode,add(32,68)),1)
            targetContract := create(0,add(bytecode,32),codelength)
        }
        require(targetContract==address(0),"SHOULD FAIL IF INITIAL IMPLEMENTATION IS NOT A CONTRACT");
        
        ERC20Imp erc20_1 = new ERC20Imp();
        assembly {
            mstore(add(bytecode,add(32,1)),address())
            mstore(add(bytecode,add(32,68)),erc20_1)
            targetContract := create(0,add(bytecode,32),codelength)
        }

        AssemblyProxyBeta proxyAsAdmin = AssemblyProxyBeta(targetContract);
        ERC20Imp proxy = ERC20Imp(address(proxyAsAdmin));

        proxy.mint(address(this),400);
        require(keccak256(abi.encodePacked(proxy.something()))==keccak256(abi.encodePacked("HELLO")),"FAILS");
        require(proxy.balanceOf(address(this))==400,"FAILS BALANCE");

        require(proxyAsAdmin.implementation()==address(erc20_1),"WRONG IMPLEMENTATION GETTER");
        ERC20Imp_2 erc20_2 = new ERC20Imp_2();

        try proxyAsAdmin.adminFunctionsPut(AssemblyProxyBeta.AdminFuctionPutType.UPGRADETO,address(1)){
            require(false,"SHOULD FAIL IF NEW IMPLEMENTATION IS NOT A CONTRACT");
        }catch (bytes memory err) {
            require(err.length==36,"INVALID ERROR MESSAGE IF NEW IMPLEMENTATION IS NOT A CONTRACT");
            uint256 code;
            address errorAddr;
            assembly {
                code := shr(224,mload(add(err,32)))
                errorAddr := mload(add(err,36))
            }
            require(code==0xcb06ac21 && errorAddr==address(1),"INVALID ERROR MESSAGE IF NEW IMPLEMENTATION IS NOT A CONTRACT");
        }

        proxyAsAdmin.adminFunctionsPut(AssemblyProxyBeta.AdminFuctionPutType.UPGRADETO,address(erc20_2));
        require(proxyAsAdmin.implementation()==address(erc20_2),"WRONG IMPLEMENTATION GETTER ON NEW ADDRESS");

        proxy.mint(address(this),400);
        require(keccak256(abi.encodePacked(proxy.something()))==keccak256(abi.encodePacked("ANOTHER NAME")),"FAILS ON NEW IMPLEMENTATION");
        require(proxy.balanceOf(address(this))==800,"FAILS BALANCE ON NEW IMPLEMENTATION");

        proxyAsAdmin.adminFunctionsPut(AssemblyProxyBeta.AdminFuctionPutType.CHANGEADMIN,address(1));

        proxy.mint(address(this),400);
        require(keccak256(abi.encodePacked(proxy.something()))==keccak256(abi.encodePacked("ANOTHER NAME")),"FAILS ON NEW IMPLEMENTATION");
        require(proxy.balanceOf(address(this))==1200,"FAILS BALANCE ON NEW IMPLEMENTATION");

    }

     function test_not_payable_error() public{
        bytes memory bytecode = hex"";
        uint256 codelength = bytecode.length;
        address targetContract;
        ERC20Imp erc20_1 = new ERC20Imp();
        assembly {
            mstore(add(bytecode,33),address())
            mstore(add(bytecode,100),erc20_1)
            targetContract := create(0,add(bytecode,32),codelength)
        }
        AssemblyProxyBetaPayable proxy = AssemblyProxyBetaPayable(targetContract);
        try proxy.implementation{value: 12}(){
            require(false,"GET IMPLEMENTATION SHOULD FAIL WITH PAYMENT");
        }catch (bytes memory err){
            require(err.length==4,"WRONG ERROR MESSAGE ON GET IMPLEMENTATION WITH PAYMENT");
            uint256 code;
            assembly{
                code := shr(224,mload(add(err,32)))
            }
            require(code==0x4e7254d6,"WRONG ERROR MESSAGE ON GET IMPLEMENTATION WITH PAYMENT");
        }

        try proxy.adminFunctionsPut{value: 12}(AssemblyProxyBeta.AdminFuctionPutType.CHANGEADMIN,address(1)){
            require(false,"CHANGE ADMIN SHOULD FAIL WITH PAYMENT");
        }catch (bytes memory err) {
            require(err.length==4,"WRONG ERROR MESSAGE ON GET IMPLEMENTATION WITH PAYMENT");
            uint256 code;
            assembly{
                code := shr(224,mload(add(err,32)))
            }
            require(code==0x4e7254d6,"WRONG ERROR MESSAGE ON GET IMPLEMENTATION WITH PAYMENT");
            
        }
        ERC20Imp_2 erc20_2 = new ERC20Imp_2();
        try proxy.adminFunctionsPut{value: 12}(AssemblyProxyBeta.AdminFuctionPutType.UPGRADETO,address(erc20_2)){
            require(false,"CHANGE IMPLEMENTATION SHOULD FAIL WITH PAYMENT");
        }catch (bytes memory err){
            require(err.length==4,"WRONG ERROR MESSAGE ON GET IMPLEMENTATION WITH PAYMENT");
            uint256 code;
            assembly{
                code := shr(224,mload(add(err,32)))
            }
            require(code==0x4e7254d6,"WRONG ERROR MESSAGE ON GET IMPLEMENTATION WITH PAYMENT");
        }
    }
}